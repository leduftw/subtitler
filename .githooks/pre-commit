#!/bin/sh
# Managed by leduftw/playbook. Change it there, not here.
#
# 1. Commits never land on main directly: every change reaches main through a
#    PR. The one exception is a new repo's very first commit.
# 2. AGENTS.md and CLAUDE.md stay byte-identical, so Codex and Claude Code read
#    the same instructions. Whichever one you edit is copied to the other; a
#    commit that edits both differently is refused rather than picking a winner.
#
# Activate per clone with: git config core.hooksPath .githooks

branch=$(git symbolic-ref --short -q HEAD || true)
if [ "$branch" = main ] && git rev-parse --verify -q HEAD >/dev/null; then
  echo "pre-commit: committing on main is blocked." >&2
  echo "  Work on a branch in its own worktree (playbook start <issue>) and land it through a PR." >&2
  exit 1
fi

C=CLAUDE.md
A=AGENTS.md

[ -f "$C" ] || [ -f "$A" ] || exit 0

if [ ! -f "$C" ]; then cp "$A" "$C"; git add "$C" "$A"; exit 0; fi
if [ ! -f "$A" ]; then cp "$C" "$A"; git add "$C" "$A"; exit 0; fi

if cmp -s "$C" "$A"; then git add "$C" "$A"; exit 0; fi

c_changed=0
a_changed=0
if git rev-parse --verify -q HEAD >/dev/null; then
  git diff --quiet HEAD -- "$C" || c_changed=1
  git diff --quiet HEAD -- "$A" || a_changed=1
else
  c_changed=1
fi

if [ "$c_changed" = 1 ] && [ "$a_changed" = 0 ]; then
  cp "$C" "$A"
elif [ "$a_changed" = 1 ] && [ "$c_changed" = 0 ]; then
  cp "$A" "$C"
else
  echo "pre-commit: CLAUDE.md and AGENTS.md were both edited and now differ." >&2
  echo "  They must stay identical. Make one match the other, then commit again." >&2
  git --no-pager diff --no-index -- "$C" "$A" >&2 || true
  exit 1
fi

git add "$C" "$A"
exit 0
